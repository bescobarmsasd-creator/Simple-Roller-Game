<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Play DOOM (Classic Shareware)</title>
    <style>
        body {
            background-color: #111;
            color: #fff;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }

        h1 {
            color: #ff3333;
            margin-bottom: 20px;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        /* Container designed to fit the native 4:3 DOS aspect ratio */
        .dosbox-container { 
            width: 640px; 
            height: 400px; 
            border: 4px solid #333;
            box-shadow: 0px 10px 30px rgba(0,0,0,0.7);
            background-color: #000;
        }

        .controls-info {
            margin-top: 25px;
            padding: 15px 25px;
            background: #222;
            border-radius: 8px;
            max-width: 500px;
            text-align: left;
            border-left: 4px solid #ff3333;
        }

        .controls-info h3 {
            margin-top: 0;
            color: #ffaa00;
        }

        ul {
            margin: 0;
            padding-left: 20px;
        }

        li {
            margin: 5px 0;
        }
    </style>
</head>
<body>

    <h1>DOOM (1993)</h1>
    
    <!-- The emulator will mount inside this div -->
    <div id="dosbox" class="dosbox-container"></div>

    <div class="controls-info">
        <h3>🎮 Classic Controls:</h3>
        <ul>
            <li><strong>Arrow Keys:</strong> Move forward/backward & turn</li>
            <li><strong>Ctrl:</strong> Fire weapon</li>
            <li><strong>Spacebar:</strong> Open doors / Activate switches</li>
            <li><strong>Alt + Left/Right Arrow:</strong> Strafe sidesteps</li>
            <li><strong>1 - 7:</strong> Change Weapons</li>
        </ul>
    </div>

    <!-- Load the official js-dos emulator scripts -->
    <script type="text/javascript" src="https://js-dos.com/cdn/js-dos-api.js"></script>
    <script type="text/javascript">
        // Initialize the emulator targeting the 'dosbox' div ID
        var dosbox = new Dosbox({
            id: "dosbox",
            onload: function (dosbox) {
                // Pulls the open-source shareware bundle directly from the js-dos network
                dosbox.run("upload/DOOM-@evilution.zip", "./doom");
            },
            onrun: function (dosbox, app) {
                console.log("DOOM is running successfully!");
            }
        });
    </script>
</body>
